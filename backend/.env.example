# Database (MySQL 8)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=report_tool

# Optional full DSN override (tests use sqlite:///... )
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/report_tool

# Uploads / exports
UPLOAD_DIR=uploads
EXPORT_DIR=exports

# Limits (FR-012, Assumptions)
MAX_UPLOAD_BYTES=10485760
MAX_ROWS=100000
